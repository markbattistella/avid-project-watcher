<Window
    x:Class="AvidProjectWatcher.Admin.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Avid Project Watcher"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#d7dce2" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Grid.Column="2" Content="Save Config" Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <TabControl Padding="12">
      <TabItem Header="Scopes">
        <Grid ColumnDefinitions="300,*">
          <Border BorderBrush="#d7dce2" BorderThickness="1" CornerRadius="6">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="10">
                <Button Content="Add" Command="{Binding AddScopeCommand}" />
                <Button Content="Remove" Command="{Binding RemoveScopeCommand}" />
              </StackPanel>
              <ListBox
                  ItemsSource="{Binding Scopes}"
                  SelectedItem="{Binding SelectedScope}"
                  Margin="10">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
            <StackPanel Spacing="14">
              <TextBlock Text="Scope" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="Enabled" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding SelectedScope.Enabled}" />

                <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedScope.Name}" />

                <TextBlock Grid.Row="2" Text="Root Path" VerticalAlignment="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                  <TextBox
                      Name="RootPathTextBox"
                      Text="{Binding SelectedScope.RootPath}"
                      Watermark="Share, mounted path, mapped drive, or folder" />
                  <Button Grid.Column="1" Content="Browse" Click="BrowseRoot_Click" />
                </Grid>
              </Grid>

              <Grid ColumnDefinitions="*,*">
                <Border BorderBrush="#d7dce2" BorderThickness="1" CornerRadius="6" Padding="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Folder Template" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                      <TextBox Text="{Binding SelectedScope.NewFolderName}" Watermark="FOOTAGE" />
                      <Button Grid.Column="1" Content="Add" Command="{Binding AddFolderCommand}" />
                      <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveFolderCommand}" />
                    </Grid>
                    <ListBox
                        MinHeight="220"
                        ItemsSource="{Binding SelectedScope.FolderTemplate}"
                        SelectedItem="{Binding SelectedScope.SelectedFolder}" />
                  </DockPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#d7dce2" BorderThickness="1" CornerRadius="6" Padding="10" Margin="14,0,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Excluded Paths" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
                      <TextBox Text="{Binding SelectedScope.NewExcludedPath}" Watermark="Folder path to exclude" />
                      <Button Grid.Column="1" Content="Add" Command="{Binding AddExclusionCommand}" />
                      <Button Grid.Column="2" Content="Browse" Click="BrowseExclusion_Click" />
                      <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveExclusionCommand}" />
                    </Grid>
                    <ListBox
                        Name="ExclusionsList"
                        MinHeight="220"
                        ItemsSource="{Binding SelectedScope.ExcludedPaths}"
                        SelectedItem="{Binding SelectedScope.SelectedExcludedPath}"
                        DragDrop.AllowDrop="True"
                        DragDrop.Drop="Exclusions_Drop" />
                  </DockPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Backfill">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Dry Run Selected Scope" Command="{Binding RunBackfillDryRunCommand}" />
            <Button Content="Commit Dry Run" Command="{Binding CommitBackfillCommand}" />
            <TextBlock Text="{Binding BackfillSummary}" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding BackfillPlans}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Scope" Binding="{Binding ScopeName}" Width="160" />
              <DataGridTextColumn Header="Project" Binding="{Binding ProjectDirectory}" Width="*" />
              <DataGridTextColumn Header="Missing Folders" Binding="{Binding FoldersToCreate.Count}" Width="130" />
              <DataGridTextColumn Header="Already Present" Binding="{Binding FoldersAlreadyPresent.Count}" Width="130" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Logs">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Refresh Logs" Command="{Binding RefreshLogsCommand}" />
            <Button Content="Export CSV" Click="ExportLogs_Click" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc}" Width="170" />
              <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="150" />
              <DataGridTextColumn Header="Scope" Binding="{Binding ScopeName}" Width="160" />
              <DataGridTextColumn Header="Project" Binding="{Binding ProjectPath}" Width="*" />
              <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="130" />
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="280" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
