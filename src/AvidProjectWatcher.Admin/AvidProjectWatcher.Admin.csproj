<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AvidProjectWatcher.Admin</AssemblyName>
    <ApplicationTitle>Avid Project Watcher</ApplicationTitle>
    <Company>MB+MAB</Company>
    <Copyright>Copyright © $([System.DateTime]::UtcNow.Year) MB+MAB</Copyright>
    <Description>Service admin UI for the Avid Project Watcher daemon.</Description>

    <!-- Version defaults to 0.0.0; overridden by -p:Version=YYYY.MM.DD in CI -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>

    <!-- macOS bundle metadata (used when dotnet publish creates a .app bundle) -->
    <CFBundleName>Avid Project Watcher</CFBundleName>
    <CFBundleDisplayName>Avid Project Watcher</CFBundleDisplayName>
    <CFBundleIdentifier>com.markbattistella.avidprojectwatcher</CFBundleIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvidProjectWatcher.Core\AvidProjectWatcher.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.*" />
  </ItemGroup>
</Project>
